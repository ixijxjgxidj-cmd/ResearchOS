{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchOSProject",
  "description": "Standard schema for ResearchOS PROJECT.md YAML frontmatter.",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_\\-]+$",
      "description": "Unique project identifier"
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable project title"
    },
    "description": {
      "type": ["string", "null"],
      "description": "Brief description of the project"
    },
    "research_goal": {
      "type": ["string", "null"],
      "description": "Core scientific or technical goal"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "default": "active"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "required": ["project_id", "project_name", "created_at", "updated_at", "status"],
  "additionalProperties": false
}
