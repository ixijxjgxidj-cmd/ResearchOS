{
  "$defs": {
    "ProjectStatus": {
      "enum": [
        "active",
        "paused",
        "completed",
        "archived"
      ],
      "title": "ProjectStatus",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "description": "Schema version",
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "description": "Unique entity identifier",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "project",
      "default": "project",
      "title": "Kind",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "name": {
      "description": "Project title",
      "title": "Name",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ProjectStatus",
      "default": "active"
    },
    "research_question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Research Question"
    },
    "objectives": {
      "items": {
        "type": "string"
      },
      "title": "Objectives",
      "type": "array"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "members": {
      "items": {
        "type": "string"
      },
      "title": "Members",
      "type": "array"
    },
    "repositories": {
      "items": {
        "type": "string"
      },
      "title": "Repositories",
      "type": "array"
    },
    "literature": {
      "description": "Referenced Paper IDs",
      "items": {
        "type": "string"
      },
      "title": "Literature",
      "type": "array"
    },
    "experiments": {
      "description": "Child Experiment IDs",
      "items": {
        "type": "string"
      },
      "title": "Experiments",
      "type": "array"
    },
    "claims": {
      "description": "Project Claim IDs",
      "items": {
        "type": "string"
      },
      "title": "Claims",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "Project",
  "type": "object"
}