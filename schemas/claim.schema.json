{
  "$defs": {
    "ClaimStatus": {
      "enum": [
        "unverified",
        "supported",
        "contradicted",
        "partially_supported",
        "abandoned"
      ],
      "title": "ClaimStatus",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "description": "Schema version",
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "description": "Unique entity identifier",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "claim",
      "default": "claim",
      "title": "Kind",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "project_id": {
      "description": "Parent Project ID",
      "title": "Project Id",
      "type": "string"
    },
    "text": {
      "description": "Scientific claim statement",
      "title": "Text",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ClaimStatus",
      "default": "unverified"
    },
    "supporting_experiments": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Experiments",
      "type": "array"
    },
    "supporting_runs": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Runs",
      "type": "array"
    },
    "contradicting_experiments": {
      "items": {
        "type": "string"
      },
      "title": "Contradicting Experiments",
      "type": "array"
    },
    "literature": {
      "items": {
        "type": "string"
      },
      "title": "Literature",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "manuscript_section": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manuscript Section"
    }
  },
  "required": [
    "id",
    "project_id",
    "text"
  ],
  "title": "Claim",
  "type": "object"
}