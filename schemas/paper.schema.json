{
  "$defs": {
    "PaperReadingStatus": {
      "enum": [
        "to_read",
        "reading",
        "read",
        "synthesized",
        "partial"
      ],
      "title": "PaperReadingStatus",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "description": "Schema version",
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "description": "Unique entity identifier",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "paper",
      "default": "paper",
      "title": "Kind",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "citekey": {
      "description": "BibTeX style unique citekey",
      "title": "Citekey",
      "type": "string"
    },
    "title": {
      "description": "Paper title",
      "title": "Title",
      "type": "string"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    },
    "journal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Journal"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "pdf_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pdf Path"
    },
    "abstract": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstract"
    },
    "reading_status": {
      "$ref": "#/$defs/PaperReadingStatus",
      "default": "to_read"
    },
    "projects": {
      "description": "Project IDs",
      "items": {
        "type": "string"
      },
      "title": "Projects",
      "type": "array"
    },
    "related_experiments": {
      "description": "Experiment IDs",
      "items": {
        "type": "string"
      },
      "title": "Related Experiments",
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "id",
    "citekey",
    "title"
  ],
  "title": "Paper",
  "type": "object"
}