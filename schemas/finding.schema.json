{
  "$defs": {
    "FindingStatus": {
      "enum": [
        "candidate",
        "verified",
        "rejected"
      ],
      "title": "FindingStatus",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "description": "Schema version",
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "description": "Unique entity identifier",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "finding",
      "default": "finding",
      "title": "Kind",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "project_id": {
      "description": "Parent Project ID",
      "title": "Project Id",
      "type": "string"
    },
    "experiment_id": {
      "description": "Originating Experiment ID",
      "title": "Experiment Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "title": {
      "description": "Finding concise statement",
      "title": "Title",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/FindingStatus",
      "default": "candidate"
    },
    "evidence_artifacts": {
      "description": "Artifact IDs",
      "items": {
        "type": "string"
      },
      "title": "Evidence Artifacts",
      "type": "array"
    },
    "literature": {
      "description": "Paper IDs",
      "items": {
        "type": "string"
      },
      "title": "Literature",
      "type": "array"
    },
    "research_question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Research Question"
    }
  },
  "required": [
    "id",
    "project_id",
    "experiment_id",
    "title"
  ],
  "title": "Finding",
  "type": "object"
}